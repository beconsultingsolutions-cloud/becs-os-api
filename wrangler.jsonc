{
  "name": "becs-os",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The console (public/index.html) is served as static files.
  // Requests under /api always go to the Worker, even if a file with that name existed.
  // Any other path with no matching file also falls through to the Worker, which answers 404 {"error":"not_found"}.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api", "/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "becs-os-core",
      "database_id": "fab9e141-867f-46bd-bfaf-75d9c3b0191b",
      // Schema changes live here as numbered .sql files (see README "Database migrations").
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      // Holds the hashed app keys ("key:<sha256>").
      "binding": "CONFIG",
      "id": "2d7e6ec8dcdf42168a74609d1d8e0edf"
    }
  ],

  // Rate limit for app keys: 60 requests per 60 seconds per key (keyed by the key's hash).
  // namespace_id is any positive whole number, unique within the Cloudflare account.
  // period must be 10 or 60. Needs wrangler 4.36.0 or later.
  "ratelimits": [
    {
      "name": "APP_LIMITER",
      "namespace_id": "4801",
      "simple": { "limit": 60, "period": 60 }
    },
    // Failed sign-ins only: 10 per 60 seconds per caller IP, so keys cannot be guessed at speed.
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "4802",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // No versioned preview addresses (<version>-becs-os-api.<subdomain>.workers.dev): they would sit outside the Access application.
  "preview_urls": false,

  // Back online 2026-11-02. Offline 2026-11-01 because the "All Workers" Access app had a Bypass
  // policy; it now uses "Owner only" (Allow, owner email, One-time PIN). /api keeps its own Bypass app.
  "workers_dev": true,

  // Cloudflare Access sign-in for the console. It is switched off unless ALL THREE are filled in
  // (see README "Turning on Cloudflare Access"):
  //   ACCESS_TEAM_DOMAIN     your Zero Trust team domain, e.g. "myteam.cloudflareaccess.com"
  //                          (anything not ending in .cloudflareaccess.com is refused)
  //   ACCESS_AUD             the "Application Audience (AUD) Tag" of the Access application
  //   ACCESS_ALLOWED_EMAILS  the email(s) allowed to sign in, comma-separated, e.g. "me@example.com"
  //                          (letter case and spaces do not matter). Anyone else Access lets through is refused.
  // None is a secret: all are visible in the Zero Trust dashboard or in the tokens themselves.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "becs2025.cloudflareaccess.com",
    "ACCESS_AUD": "ea52c3204b0387c7c71a48c153e4dcfdf691942bcb18f19ad8c711984636fb67",
    "ACCESS_ALLOWED_EMAILS": "beconsultingsolutions@gmail.com",
    // Square sync (src/square.ts). The exact webhook URL registered in Square: it is part of the
    // signature Square sends, so it must match character for character. Not a secret.
    // The two secrets are set by the owner only: wrangler secret put SQUARE_WEBHOOK_SIGNATURE_KEY
    // and wrangler secret put SQUARE_ACCESS_TOKEN. Without them the sync stays off.
    "SQUARE_WEBHOOK_URL": "https://becs-os.be-consulting-solutions.workers.dev/api/webhooks/square"
  },

  // Daily Square check at 13:00 UTC (7 AM Central): asks Square about open linked invoices
  // and fixes anything a missed webhook left behind. Does nothing until SQUARE_ACCESS_TOKEN is set.
  "triggers": { "crons": ["0 13 * * *"] }
}
