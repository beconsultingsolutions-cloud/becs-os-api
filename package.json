{
  "name": "becs-os-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply becs-os-core --local",
    "db:migrate:remote": "wrangler d1 migrations apply becs-os-core --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc --noEmit -p test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "typescript": "^5.6.0",
    "vitest": "4.1.11",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
